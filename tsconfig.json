{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/vite-env.d.ts",
    "src/App.tsx",
    "src/main.tsx",
    "src/types/leaderboard.ts",
    "src/types/game.ts",
    "src/data/leaderboardData.ts",
    "src/components/LeaderboardDashboard.tsx",
    "src/components/GiftingModal.tsx",
    "src/utils/audio.ts",
    "src/utils/confetti.ts",
    "src/utils/flutterwave.ts",
    "src/utils/simulation.ts",
    "server.ts"
  ]
}
