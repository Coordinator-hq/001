# -------------------------------------------------------------
# FanBrawl Environment Configuration
# -------------------------------------------------------------

# Flutterwave Payment Gateway (Required for Live Money Gifts)
# Public key for the frontend inline checkout modal
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxx-X

# Secret key for server-side verification and reconciliation
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxx-X

# Secret webhook signature hash for async reconciliation
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_webhook_secret_hash_here

# -------------------------------------------------------------
# Optional: High-Concurrency Real-Time Scaling (10,000+ Users on Vercel)
# -------------------------------------------------------------
# Managed WebSocket Pub/Sub via Pusher or Ably (offloads 10k connections from Vercel)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1
PUSHER_APP_ID=
PUSHER_SECRET=

# Distributed Serverless Atomic Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server runtime
PORT=3000
NODE_ENV=development